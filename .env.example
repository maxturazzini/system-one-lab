# Copiate questo file in .env e compilate solo quello che vi serve.

# Jev, il modello proprietario di TypeSafe. auto = Vercel se c'è la chiave, altrimenti Cloudflare.
JEV_PROVIDER=auto

# Vercel AI Gateway
AI_GATEWAY_API_KEY=
JEV_MODEL=typesafe-ai/jev
# Zero Data Retention: solo sui piani Pro ed Enterprise. Sul piano Hobby mettete false e usate dati pubblici o sintetici.
JEV_ZERO_DATA_RETENTION=false

# Cloudflare Workers AI
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_API_TOKEN=
CLOUDFLARE_JEV_MODEL=typesafe/jev

# SemIf, il motore aperto che gira sul vostro computer (vedi README)
SEMIF_PYTHON=
SEMIF_PORT=4318
SEMIF_MODE=direct
SEMIF_THREADS=
SEMIF_URL=

# Server del lab
HOST=127.0.0.1
PORT=4317
# User-Agent per le richieste alle fonti pubbliche (facoltativo)
PUBLIC_DATA_USER_AGENT=
